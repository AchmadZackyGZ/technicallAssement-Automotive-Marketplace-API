{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none",
        "ignoreRestSiblings": true
      }
    ],
    "no-console": "warn",
    "eqeqeq": ["error", "smart"],
    "prefer-const": "error",
    "no-var": "error",
    "object-shorthand": "warn",
    "curly": ["error", "multi-line"]
  },
  "overrides": [
    {
      "files": ["src/db/seed.js", "src/db/migrate.js", "scripts/**/*.js"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["tests/**/*.js"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
