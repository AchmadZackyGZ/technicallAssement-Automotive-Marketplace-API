# ---------------------------------------------------------------------------
# Automotive Marketplace API - environment template
# Copy to `.env` and adjust. Never commit a real `.env` file.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# --- Database --------------------------------------------------------------
# Preferred: a single connection string (Railway/Heroku style).
# When DATABASE_URL is present the discrete PG* values below are ignored.
DATABASE_URL=postgres://marketplace:marketplace@localhost:5432/automotive_marketplace

# Discrete connection settings (used by docker-compose and local installs).
PGHOST=localhost
PGPORT=5432
PGUSER=marketplace
PGPASSWORD=marketplace
PGDATABASE=automotive_marketplace

# Set to "true" when your provider requires TLS (Railway public proxy, Render, ...).
DB_SSL=false

# Connection pool sizing.
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# --- Authentication --------------------------------------------------------
# HS256 shared secret. MUST be replaced with a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-super-secret-value
JWT_EXPIRES_IN=7d
JWT_ISSUER=automotive-marketplace-api

# bcrypt cost factor (10-12 is a sensible range).
BCRYPT_ROUNDS=10

# --- Redis (optional - enables response caching for search endpoints) -----
# Leave REDIS_URL empty to run without caching; the API degrades gracefully.
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60
CACHE_ENABLED=true

# --- HTTP hardening --------------------------------------------------------
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Seed script -----------------------------------------------------------
SEED_LISTINGS=600
SEED_SELLERS=25
SEED_RESET=false
